{
  "name": "videomaster",
  "version": "2.0.0",
  "private": true,
  "description": "محمّل فيديو حقيقي وسريع بدون إعلانات، يدعم YouTube و TikTok و Twitter/X و Reddit",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/generate-sitemap.mjs",
    "preview": "vite preview",
    "lint": "eslint src netlify scripts public/sw.js --ext js,jsx,mjs --max-warnings 0",
    "test:extract": "node scripts/verify-engine.mjs",
    "test:sw": "node scripts/verify-sw.mjs",
    "test:mux": "node scripts/verify-muxer.mjs",
    "verify": "npm run lint && npm run test:sw && npm run test:mux && npm run test:extract"
  },
  "keywords": [
    "video-downloader",
    "youtube-downloader",
    "tiktok-downloader",
    "تحميل-فيديو",
    "تنزيل-فيديوهات"
  ],
  "author": "Mohamed khairy",
  "license": "MIT",
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.15.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@vitejs/plugin-react": "^4.0.3",
    "autoprefixer": "^10.4.14",
    "eslint": "^8.45.0",
    "eslint-plugin-react": "^7.32.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "postcss": "^8.4.27",
    "tailwindcss": "^3.3.0",
    "terser": "^5.43.1",
    "vite": "^4.4.5"
  }
}
